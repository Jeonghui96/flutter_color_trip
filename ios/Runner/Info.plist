	<key>NSLocationWhenInUseUsageDescription</key>
	<string>앱이 현재 위치를 확인하려면 권한이 필요합니다.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>앱이 항상 위치를 사용하려면 권한이 필요합니다.</string>

	<!-- Flutter 웹뷰 등 -->
	<key>io.flutter.embedded_views_preview</key>
	<true/>

	<!-- Google 로그인 Client ID -->
	<key>GIDClientID</key>
	<string>2257359194449-etrhkdluv7v3i109pesbu2qi3iu7h873.apps.googleusercontent.com</string>

	<!-- ✅ Google + Apple 로그인용 URL 스킴 -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- ✅ Google 로그인 -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.257359194449-etrhkdluv7v3i109pesbu2qi3iu7h873</string> <!-- 실제 REVERSED_CLIENT_ID -->
			</array>
		</dict>

		<!-- ✅ Apple 로그인 -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.sparta.colortrip</string> <!-- 앱 번들 ID -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.sparta.colortrip</string> <!-- 서비스 ID 또는 번들 ID와 동일 -->
			</array>
		</dict>
	</array>

	<!-- ✅ 외부 URL 스킴 허용 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>google</string>
		<string>com.googleusercontent.apps</string>
		<string>com.apple</string> <!-- Apple 로그인 시 사용 -->
	</array>
